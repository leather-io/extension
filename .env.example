# =============================================================================
# Leather Browser Extension - Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values as needed.
# For local development, most values can be left as placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------

# Wallet environment: 'development', 'testing', or 'production'
# Set to 'testing' when running integration tests locally
WALLET_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------

# Segment analytics write key for tracking user events
SEGMENT_WRITE_KEY=segmentwritekey

# Sentry DSN for error tracking and monitoring
SENTRY_DSN=sentrydsn

# -----------------------------------------------------------------------------
# Third-Party Integrations
# -----------------------------------------------------------------------------

# Coinbase integration for fiat on-ramp
COINBASE_APP_ID=coinbaseappid

# MoonPay integration for fiat on-ramp
MOONPAY_API_KEY=moonpayapikey

# Transak integration for fiat on-ramp
TRANSAK_API_KEY=transakapikey

# -----------------------------------------------------------------------------
# Data Providers
# -----------------------------------------------------------------------------

# Best in Slot API for ordinals/inscriptions data
BESTINSLOT_API_KEY=bestinslotapikey

# -----------------------------------------------------------------------------
# Bitflow Integration (DEX)
# -----------------------------------------------------------------------------

# Bitflow API configuration
BITFLOW_API_HOST=bitflowapihost
BITFLOW_API_KEY=bitflowapikey

# Bitflow read-only call API (for fetching quotes)
BITFLOW_READONLY_CALL_API_HOST=bitflowreadonlycallapihost
BITFLOW_READONLY_CALL_API_KEY=bitflowreadonlycallapikey

# Bitflow keeper API (for transaction execution)
BITFLOW_KEEPER_API_HOST=bitflowkeeperapihost
BITFLOW_KEEPER_API_KEY=bitflowkeeperapikey
